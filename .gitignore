# ─────────────────────────────────────────────────────────────
# 이 저장소가 담는 범위
#
#   docs/            서비스 사이의 규약
#   lib/             여러 스크립트가 공유하는 셸·Node 조각
#   site/            여러 곳이 함께 쓰는 값 (호스트·tls_mode)
#   nginx/           리버스 프록시 설정과 스크립트, 공인 인증서(public_ca/)
#   database/        MariaDB 설치·설정
#   pm2/             프로세스 오케스트레이션
#   services/manager 관리 대시보드
#
# 나머지 서비스(face-recognition-server, apartment-mgmt-server,
# web-cassini)는 각자 자기 git 저장소를 가집니다.
# 여기서 같이 추적하면 같은 파일이 두 저장소에 들어갑니다.
# 그 서비스들은 선언 둘(nginx-conf/ · pm2-conf/)만 맞추면 붙는
# **plug-in** 입니다 — 이 저장소는 그 코드를 알 필요가 없습니다.
# ─────────────────────────────────────────────────────────────
services/*
!services/manager/

# services/ 바로 아래의 공유 세션 시크릿. 위 규칙에 이미 걸리지만
# 실수로 예외를 추가할 때를 대비해 한 번 더 막습니다.
services/.session-secret


# ── 옮겨 온 층의 비밀 · 장비별 값 ─────────────────────────────
# 사이트 값 — 장비마다 다르다 (site/settings-schema.json 이 정의)
site/settings.ini
site/.applied-settings

# DB 비밀번호와 덤프
database/secrets/
database/backups/

# nginx/cert/ 는 통째로 뺀다. 서버·CA·클라이언트 개인키가 모두 여기 있다.
# CA 를 다시 만들면 이미 배포한 클라이언트 인증서가 전부 무효가 되므로,
# "다시 생성하면 되는 것" 이 아니라 **따로 백업해야 하는 자산**이다.
nginx/cert/

# 서비스가 장비마다 갖는 값 (docs/guide/contracts.md 의 '세 파일' 규약)
services/*/settings.ini
services/*/.applied-settings
services/*/settings.json
services/*/secrets/

# Firebase 서비스 계정 키. 이 키는 FCM 발송 자격이라 커밋되면 누구나
# 이 단지 단말에 푸시를 보낼 수 있다.
**/*firebase-adminsdk*.json

# 패킷 캡처. 실제 SIP/SDP 신호가 들어 있어 내선 번호와 단말 주소가 노출된다.
*.pcap
*.pcapng


# ── 자격 증명 · 인증서 ────────────────────────────────────────
# nginx/certs 에는 CA 개인키(ca_key.pem)와 서버 개인키(key.pem)가 있습니다.
# 공개 인증서까지 한 디렉토리에 섞여 있어 통째로 제외합니다.
# 필요하면 nginx/generate_all_certificates.sh 로 다시 만듭니다.
nginx/certs/

# 관리자 비밀번호 해시가 들어 있습니다. config.example.json 만 커밋합니다.
services/manager/config.json
# DB 비밀번호 파일.
services/manager/secrets/

# 어느 디렉토리든 이런 것은 커밋하지 않습니다.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.srl
secrets/


# ── 빌드 산출물 · 의존성 ──────────────────────────────────────
node_modules/
dist/
# manager 프론트엔드 빌드 결과. web/ 에서 npm run build 로 만듭니다.
services/manager/server/public/


# ── 로그 · 런타임 ────────────────────────────────────────────
*.log
logs/
*.pid
data/
*.sqlite
*.db


# ── 도구 · 편집기 ────────────────────────────────────────────
# Claude Code 의 장비별 설정과 작업 트리(저장소 전체 사본).
# ⚠️ `**/` 가 있어야 합니다. `.claude/worktrees/` 처럼 가운데에 슬래시가 있는
#    패턴은 **이 파일이 있는 디렉토리에 anchor** 되어 저장소 뿌리의 것만
#    걸립니다. services/manager/.claude/ 처럼 서비스
#    아래에서 연 것은 그대로 새어 나옵니다.
#
#    워크트리는 **저장소 전체 사본**이라 새면 통째로 커밋됩니다. 실제로
#    `git add -A` 한 번에 services/manager/.claude/worktrees/ 아래가
#    전부 담겼습니다 (2026-09-07).
**/.claude/settings.local.json
**/.claude/worktrees/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# macOS 가 만드는 사이드카. Mac 을 거친 복사(exFAT USB · SMB 공유 · Mac 에서
# 만든 zip)에서 파일마다 하나씩 딸려 온다. 확장 속성과 리소스 포크를 담을 수
# 없는 파일시스템이라 옆에 따로 쓰는 것이고, 리눅스에서는 쓸모가 없다.
#
# 같은 복사가 권한도 644 → 755 로 뒤집어 놓는다. 그쪽은 .gitignore 로 막을 수
# 없으니 git diff --summary 의 'mode change' 를 보고 되돌려야 한다.
#
# **애초에 파일 복사 말고 git 으로 옮기는 편이 낫다.**
._*
__MACOSX/


# ── 실수로 생기는 것 ──────────────────────────────────────────
# 파이썬 캐시 (nginx/generate_nginx_conf.py 를 돌리면 생긴다)
__pycache__/

# 의존성이 없는 자리에서 npm 이 만든 빈 lock. 실제 lock 은 각 server/ · web/ 안에 있다.
#   pm2/ 에는 package.json 이 없고, services/manager/ 뿌리의
#   package.json 은 스크립트만 있다.
/pm2/package-lock.json
/services/manager/package-lock.json

